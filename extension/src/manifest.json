{
  "manifest_version": 3,
  "name": "Joker Hegemon Extension Wallet",
  "short_name": "Joker HGN",
  "version": "0.1.0",
  "description": "Private post-quantum wallet for Hegemon (HGN). Keys, scanning and proofs stay in your browser.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Joker Hegemon Wallet",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "offscreen", "proxy"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://check.torproject.org/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' http: https:; img-src 'self' data:; style-src 'self'; default-src 'self'"
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+H", "mac": "Alt+Shift+H" }, "description": "Open the wallet" }
  }
}
